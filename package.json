{
	"name": "neurotic-docx-bench-drivers",
	"private": true,
	"type": "module",
	"description": "Six benchmarks to neurotically measure DOCX conversion and redlining against Microsoft Word.",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "tsc --noEmit",
		"lint": "oxlint .",
		"update-readme-ranking": "node --import tsx scripts/update-readme-ranking.ts",
		"redline-speed-bench": "node --import tsx scripts/redline_speed_bench.ts",
		"redline-speed-bench:native": "node --import tsx scripts/redline_speed_bench.ts --methods jubarte-rust-inproc,docxodus-csharp-inproc,jubarte-rust,docxodus-csharp,docxodus --fixture-count 1000 --min-pairs 5000 --warmup 50 --reps 1 --out results/redline_speed_bench",
		"redline-speed-bench:warm": "node --import tsx scripts/redline_speed_bench.ts --methods jubarte-rust-inproc,docxodus-csharp-inproc --fixture-count 1000 --min-pairs 5000 --warmup 50 --reps 1 --no-profile --out results/redline_speed_bench/warm_vs_warm",
		"redline-speed-bench:thesis": "node --import tsx scripts/redline_speed_bench.ts --methods jubarte-rust-inproc,docxodus-csharp-inproc,jubarte-rust,docxodus-csharp,docxodus --fixture-count 1000 --min-pairs 5000 --warmup 50 --reps 1 --out results/redline_speed_bench/thesis_evidence",
		"redline-speed-bench:ts6-vs-ts7": "node scripts/redline_speed_bench_ts6_vs_ts7.mjs"
	},
	"dependencies": {
		"@cantoo/pdf-lib": "2.7.3",
		"@pdf-lib/fontkit": "^1.1.1",
		"@pdfme/common": "^6.1.11",
		"@pdfme/converter": "^6.1.11",
		"@pdfme/generator": "^6.1.11",
		"@pdfme/schemas": "^6.1.11",
		"@stll/folio-core": "0.17.1",
		"@superdoc-dev/sdk": "1.21.3",
		"@types/node": "^26.1.1",
		"@xmldom/xmldom": "^0.9.10",
		"base64-js": "^1.5.1",
		"color-name": "^2.1.0",
		"commander": "^15.0.0",
		"crypto-js": "^4.2.0",
		"csv-parse": "^7.0.1",
		"dingbat-to-unicode": "^1.0.1",
		"docxodus": "9.8.0",
		"es-toolkit": "^1.49.0",
		"fast-xml-parser": "^5.10.0",
		"fflate": "^0.8.3",
		"html-entities": "^2.6.0",
		"jszip": "^3.10.1",
		"libxmljs2": "^0.37.0",
		"lop": "^0.4.2",
		"nanoid": "^6.0.0",
		"pdfjs-dist": "^6.1.200",
		"prosemirror-model": "^1.25.11",
		"prosemirror-state": "^1.4.4",
		"superdoc": "2.3.0",
		"tmp": "^0.2.7",
		"underscore": "^1.13.8",
		"unpdf": "^1.6.2",
		"xpath": "^0.0.34"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.1.10",
		"oxlint": "^1.74.0",
		"playwright": "^1.61.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
