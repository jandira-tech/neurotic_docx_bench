  },
  "openapi": "3.1.0",
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "code",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable failure description."
          },
          "code": {
            "type": "string",
            "enum": [
              "active_content",
              "bad_multipart",
              "bad_request",
              "busy",
              "compare_failed",
              "convert_failed",
              "corrupt",
              "encrypted",
              "external_content",
              "headers_too_large",
              "http_version",
              "length_required",
              "macros",
              "method_not_allowed",
              "missing_compare_files",
              "missing_document",
              "no_output",
              "not_docx",
              "not_found",
              "not_implemented",
              "password_protected",
              "query_rejected",
              "rate_limited",
              "timeout",
              "too_large",
              "too_many_parts",
              "unauthorized",
              "unexpected_field",
              "unsafe_package",
              "unsupported_encoding",
              "uri_too_long",
              "word_failed"
            ],
            "description": "Machine-readable status code."
          },
          "request_id": {
            "type": "string",
            "description": "Identifier to correlate with server logs."
          }
        }
      },
      "Live": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "ready",
          "workers"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Overall HTTP status."
          },
          "ready": {
            "type": "boolean",
            "description": "True when both Word workers are serving."
          },
          "workers": {
            "type": "object",
            "description": "Per-lane worker state, keyed by lane name.",
            "additionalProperties": {
              "type": "object"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token created in .env on first start (WORD_API_TOKEN)."
      }
    }
  }
}
