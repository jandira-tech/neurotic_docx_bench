                }
              }
            }
          }
        }
      }
    },
    "/v1/convert": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Convert one .docx file to PDF.",
        "description": "PDF export omits document properties and always includes markup when present.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "document"
                ],
                "properties": {
                  "document": {
                    "type": "string",
                    "format": "binary",
                    "description": "Source .docx (max 20 MB)."
                  }
                }
              },
              "encoding": {
                "document": {
                  "contentType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PDF rendered from the uploaded document.",
            "headers": {
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "Request identifier echoed by the server."
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string",
                  "const": "attachment; filename=\"document.pdf\""
                },
                "description": "Download filename."
              }
            },
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Error body. code is one of: query_rejected, bad_multipart, too_many_parts, unexpected_field, missing_document, not_docx, encrypted, macros, active_content, external_content, unsafe_package, password_protected, corrupt.",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error body. code is one of: unauthorized.",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error body. code is one of: not_found.",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Error body. code is one of: method_not_allowed.",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "411": {
            "description": "Error body. code is one of: length_required.",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Error body. code is one of: too_large.",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Error body. code is one of: unsupported_encoding.",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Error body. code is one of: rate_limited.",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "const": 5
                },
                "description": "Seconds to wait before retrying."
              }
            }
          },
          "500": {
            "description": "Error body. code is one of: convert_failed, no_output, word_failed.",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error body. code is one of: busy.",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "const": 5
                },
                "description": "Seconds to wait before retrying."
              }
            }
          },
