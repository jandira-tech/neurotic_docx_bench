WORD_API_TOKEN=replace-with-at-least-32-random-characters
PORT=8787

# Optional. When this is set, scripts/start.ps1 uses your named tunnel
# instead of a temporary trycloudflare.com address.
# CLOUDFLARE_TUNNEL_TOKEN=

# Stable public address. When this is set, start.ps1 does not replace it
# with a temporary trycloudflare.com tunnel.
# WORD_PUBLIC_URL=https://docx.example.com

# One warm Word process handles comparisons and another handles PDFs.
# RATE_LIMIT_PER_MINUTE=300
# QUEUE_TIMEOUT_SECONDS=180
# MAX_CONCURRENT=4
# JOB_TIMEOUT_SECONDS=120
