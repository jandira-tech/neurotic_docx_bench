---
// SPDX-FileCopyrightText: 2026 Jandira Technologies, LLC
// SPDX-License-Identifier: AGPL-3.0-only
import '../styles/jubarte.css';
Astro.response.headers.set('Cache-Control', 'no-store');
const prefix = Astro.request.headers.get('x-bench-prefix') ?? '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>try { const theme = localStorage.getItem("jb-theme"); if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme; } catch {}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Jubarte Live Bench: continuous DOCX conversion and redline measurements, actual fixtures, scores and PDF evidence." />
    <meta name="theme-color" content="#f5f5f2" />
    <title>Jubarte · Live Bench</title>
  </head>
  <body data-prefix={prefix}>
    <a class="skip" href="#main">Skip to measurements</a>
    <header class="masthead">
      <a class="brand" href={prefix || '/'} aria-label="Jubarte Live Bench home"><svg class="brand-mark" viewBox="0 0 560 360" width="34" height="22" aria-hidden="true"><g transform="rotate(-5 280 200)"><path class="mk-body" d="M 76 192 C 82 172 112 156 150 146 C 196 132 258 112 310 110 C 356 108 402 118 448 148 C 458 152 464 150 470 144 C 478 128 494 106 520 92 C 512 112 508 126 502 134 C 514 140 526 148 540 160 C 520 164 498 160 480 162 C 470 164 460 166 452 166 C 420 190 382 228 328 252 C 270 278 194 286 148 268 C 114 254 88 230 81 208 C 76 198 74 194 76 192 Z"/><path class="mk-fin" d="M 208 228 C 246 240 286 268 322 298 C 334 308 338 320 330 326 C 296 326 254 306 226 280 C 206 260 200 240 208 228 Z"/><circle class="mk-eye" cx="122" cy="196" r="6"/></g></svg><span><span class="brand-word">JUBARTE</span><span class="brand-sub">LIVE BENCH</span></span></a>
      <nav aria-label="Primary"><a href="#comparison">PDF evidence</a><a href="#history">All reviews</a><a href="https://github.com/jandira-tech/neurotic_docx_bench/tree/c/jubarte-live-bench/live-bench">Source ↗</a></nav>
      <span id="connection" class="connection waiting" role="status"><i></i><span>Connecting</span></span>
    </header>
    <main id="main">
      <section class="intro"><div><p class="eyebrow">CONTINUOUS DOCUMENT ENGINE MEASUREMENTS</p><h1>Every document.<br/><span>Measured live.</span></h1><p class="lede">Real DOCX fixtures. Actual conversions and tracked changes.<br/>Every score comes with the files that produced it.</p></div><div class="intro-note"><span class="spec">01 / LIVE PIPELINE</span><p>Jubarte against Docxodus and SuperDoc Redlines.<br/>PDF conversion against LibreOffice and docxide.</p><p class="muted">Measured cohorts keep their reference tool and renderer together. Broken candidates count as zero. Unavailable tools and infrastructure errors are excluded.</p></div></section>
      <section class="telemetry" aria-label="Live worker state"><div><span class="label">NOW PROCESSING</span><strong id="current-fixture">Waiting for first fixture</strong><span id="phase" class="mono">No heartbeat received</span></div><div><span class="label">COMPLETED THIS RUN</span><strong id="completed">—</strong><span class="mono">Independent review occurrences</span></div><div><span class="label">QUEUE DEPTH</span><strong id="queue">—</strong><span class="mono">Fixtures pending</span></div><div><span class="label">LAST HEARTBEAT</span><strong id="heartbeat">—</strong><span id="run-id" class="mono">No active run</span></div></section>
      <section class="overview"><div class="section-heading"><h2>Measured cohorts</h2><span id="cohort-context" class="mono muted">Awaiting evidence</span></div><div id="cohorts" class="cohorts"><p class="empty">No scores yet. The worker’s first completed fixture will appear here.</p></div></section>
      <section id="comparison" class="evidence"><div class="section-heading"><div><p class="eyebrow">02 / INSPECT THE OUTPUT</p><h2>Candidate × reference</h2></div><div class="rotate-controls"><button id="previous-result" aria-label="Previous completed fixture">←</button><button id="rotation" aria-pressed="false">Pause rotation</button><button id="next-result" aria-label="Next completed fixture">→</button></div></div>
        <div class="evidence-toolbar"><div class="tabs" role="group" aria-label="Benchmark"><button data-benchmark="convert" class="active" aria-pressed="true">Conversion</button><button data-benchmark="redline" aria-pressed="false">Redline</button></div><label>Candidate <select id="tool"><option value="jubarte">Jubarte</option></select></label><span id="rotation-status" class="mono muted">Following completed fixtures · 10s delay</span></div>
        <div class="fixture-info"><div><span class="label">DISPLAYED COMPLETED FIXTURE</span><h3 id="display-fixture">Waiting for completed results</h3><p id="fixture-source" class="mono muted">Source URL and checksum will accompany every result.</p><p id="previous-source" class="mono muted"></p></div><div class="result-value"><span class="label">FIDELITY / 100</span><strong id="result-score">—</strong><span id="reference-note" class="mono muted">No reference available</span></div></div>
        <div class="pdf-grid"><article><div class="pdf-heading"><h3 id="candidate-title">Jubarte</h3><a id="candidate-open" target="_blank" rel="noopener" hidden>Open PDF ↗</a></div><div class="pdf-slot" id="candidate-pdf"><p>Candidate PDF arrives after a successful render.</p></div></article><article><div class="pdf-heading"><h3 id="reference-title">Reference</h3><a id="reference-open" target="_blank" rel="noopener" hidden>Open PDF ↗</a></div><div class="pdf-slot" id="reference-pdf"><p>Reference PDF arrives with its measured cohort.</p></div></article></div>
        <div id="score-visualization" hidden><h3>First page comparison & page fidelity</h3><img id="score-image" loading="lazy" alt="Reference, candidate, pixel difference, and measured fidelity across pages" style="width:100%;height:auto" /></div>
        <div class="detail-grid"><div><h3>Metrics & functional checks</h3><dl id="metrics"><p class="empty">Select a completed measurement to inspect its metrics.</p></dl></div><div><h3>Execution trace</h3><ol id="stages" class="stages"><li class="empty">No completed stages yet.</li></ol></div></div>
        <details class="provenance"><summary>Review metadata & permanent artifacts</summary><div id="artifact-links"></div><pre id="review-metadata">No completed review selected.</pre></details>
      </section>
      <section id="history" class="history"><div class="section-heading"><div><p class="eyebrow">03 / EVERY REVIEW IS PRESERVED</p><h2>All reviewed fixtures</h2></div><span class="mono muted">Across every run · select a review to inspect</span></div><form id="history-search" class="search-form" role="search"><label for="history-query">Search fixtures, metadata or review ID</label><input id="history-query" name="q" type="search" maxlength="200" placeholder="Fixture ID, filename, topic, language…" /><button type="submit">Search history</button><button id="history-reset" type="button">Latest reviews</button></form><p id="history-status" class="mono muted" role="status">Loading reviewed fixtures…</p><div class="table-scroll"><table><thead><tr><th>Occurrence</th><th>Fixture</th><th>Completed</th><th>Conversion</th><th>Redline</th></tr></thead><tbody id="results"><tr><td colspan="5" class="empty">Nothing measured yet. No sample scores are shown.</td></tr></tbody></table></div><button id="history-more" hidden>Load older reviews</button></section>
      <details class="provenance"><summary>Runtime versions & measurement configuration</summary><pre id="versions">No run metadata received.</pre></details>
    </main>
    <footer><span class="brand-footer">jubarte<span> LIVE BENCH</span></span><p>Continuous measurements · Open methodology · Permanent evidence</p><span id="last-refresh" class="mono muted">Connecting to feed</span></footer>
    <script>import '../scripts/dashboard';</script>
  </body>
</html>
<style is:global>
  :root{font-family:var(--sans);color:var(--ink);background:var(--bg);--lime:var(--primary);--red:var(--del)}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:20px}body{margin:0}a{color:inherit;text-underline-offset:4px}button,select{font:inherit}button{cursor:pointer;background:var(--surface);color:inherit;border:1px solid var(--line-strong);border-radius:var(--radius);padding:9px 13px}button:hover,button:focus-visible{background:var(--hover);border-color:var(--lime)}button:disabled{opacity:.4;cursor:default}select{background:var(--surface);color:inherit;border:1px solid var(--line-strong);border-radius:var(--radius);padding:9px 30px 9px 10px}button:focus-visible,a:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--lime);outline-offset:3px}.skip{position:absolute;left:20px;top:-100px;z-index:3;background:var(--lime);color:var(--bg);padding:12px}.skip:focus{top:8px}.masthead,main,footer{max-width:var(--max);margin:auto}.masthead{display:flex;align-items:center;padding:28px 44px;gap:32px;border-bottom:1px solid var(--line)}.brand{text-decoration:none;display:flex;gap:10px;align-items:center;color:var(--ink);font-size:22px;font-weight:500;letter-spacing:0}.brand svg{width:44px;height:30px}.brand-sub{display:block;font-size:9px;letter-spacing:3.1px;font-weight:500;margin-top:2px;color:var(--ink)}.masthead nav{margin:auto;display:flex;gap:28px;font-size:13px;color:var(--ink)}.masthead nav a{text-decoration:none}.connection{font:12px var(--mono);display:flex;gap:9px;align-items:center;white-space:nowrap;color:var(--muted)}.connection i{width:7px;height:7px;border-radius:50%;background:var(--disabled)}.connection.live{color:var(--lime)}.connection.live i{background:var(--lime);box-shadow:0 0 0 4px var(--hl-soft)}.connection.offline,.connection.stale{color:var(--del)}.connection.offline i,.connection.stale i{background:var(--del)}main{padding:0 44px}.intro{display:grid;grid-template-columns:1.3fr 1fr;gap:60px;padding:56px 0 44px;align-items:end}.eyebrow,.label,.spec{font:10px var(--mono);letter-spacing:1.6px;color:var(--muted)}.eyebrow{margin:0 0 20px}.intro h1{font-size:clamp(60px,6vw,90px);line-height:.96;letter-spacing:-5px;font-weight:500;margin:0 0 24px}.intro h1 span{color:var(--lime)}.lede{font-size:16px;line-height:1.6;color:var(--ink)}.intro-note{font-size:14px;line-height:1.7;max-width:450px;justify-self:end}.intro-note .spec{color:var(--lime)}.muted{color:var(--muted)}.mono{font:11px var(--mono);line-height:1.6;overflow-wrap:anywhere}.telemetry{display:grid;grid-template-columns:2.4fr 1fr 1fr 1.2fr;border:1px solid var(--line);background:var(--surface);margin-bottom:46px}.telemetry>div{padding:23px;display:flex;flex-direction:column;gap:12px;border-right:1px solid var(--line);min-width:0}.telemetry>div:last-child{border:0}.telemetry strong{font:32px var(--mono);letter-spacing:-1px}.telemetry>div:first-child strong{font-size:17px;letter-spacing:0;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.telemetry .mono{color:var(--ink)}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:20px}h2{font-size:25px;font-weight:500;letter-spacing:-.6px;margin:0}h3{font-size:14px;font-weight:500}section{margin-bottom:46px}.cohorts{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.cohort{border-top:2px solid var(--line-strong);background:var(--surface);padding:20px}.cohort.jubarte{border-color:var(--lime)}.cohort-title{display:flex;justify-content:space-between;gap:15px;align-items:center;font-size:14px}.cohort-title span{font:10px var(--mono);text-transform:uppercase;color:var(--muted)}.cohort strong{display:block;font:38px var(--mono);letter-spacing:-1px;color:var(--lime);margin:20px 0 10px}.cohort p{margin:7px 0}.cohort .broken{color:var(--red)}.overview{padding-bottom:10px}.empty{font-size:13px;line-height:1.8;color:var(--muted);padding:12px 0}.cohorts>.empty,.batch-grid>.empty{grid-column:1/-1}.evidence{border-top:1px solid var(--line);padding-top:32px}.evidence .eyebrow{margin-bottom:12px}.rotate-controls{display:flex;gap:6px}.rotate-controls button{font-size:12px}.evidence-toolbar{display:flex;align-items:center;gap:22px;background:var(--surface);padding:14px;border:1px solid var(--line)}.tabs{display:flex;gap:3px}.tabs button{background:none;border-color:transparent;color:var(--ink)}.tabs .active{background:var(--lime);color:var(--on-cta)}.evidence-toolbar label{font:12px var(--mono);display:flex;align-items:center;gap:10px}.evidence-toolbar>span{margin-left:auto}.fixture-info{display:flex;justify-content:space-between;gap:25px;padding:26px 0}.fixture-info h3{font-size:21px;margin:12px 0 8px;overflow-wrap:anywhere}.fixture-info .mono{margin:4px 0}.result-value{text-align:right;min-width:160px;display:flex;flex-direction:column;gap:8px}.result-value strong{font:32px var(--mono);color:var(--lime)}.result-value strong.broken{color:var(--red);font-size:22px}.pdf-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.pdf-grid article{border:1px solid var(--line);background:var(--surface)}.pdf-heading{display:flex;align-items:center;justify-content:space-between;padding:2px 16px}.pdf-heading a{font:11px var(--mono)}.pdf-slot{height:620px;background:var(--surface2);display:flex;align-items:center;justify-content:center;color:var(--ink);font:13px var(--mono);text-align:center}.pdf-slot p{padding:32px}.pdf-slot iframe{width:100%;height:100%;border:0;background:white}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:22px}.detail-grid>div{min-width:0}.detail-grid h3{color:var(--ink);border-bottom:1px solid var(--line);padding-bottom:15px}dl{font:12px var(--mono);display:grid;grid-template-columns:1fr auto;gap:9px 18px}dt{color:var(--muted)}dd{margin:0;overflow-wrap:anywhere;max-width:320px}.stages{list-style:none;margin:0;padding:0;font:11px var(--mono)}.stages li{padding:10px 0;border-bottom:1px solid var(--line)}.stage-row{display:flex;gap:12px;justify-content:space-between}.stage-error{font-size:10px;color:var(--red);line-height:1.6;margin:8px 0 0;white-space:pre-wrap;overflow-wrap:anywhere}.status-ok{color:var(--lime)}.status-broken,.status-error{color:var(--red)}.status-unavailable,.status-reference{color:var(--muted)}.stages a{color:var(--muted);display:inline-block;margin-top:6px}.table-scroll{overflow:auto}table{width:100%;border-collapse:collapse;text-align:left;font:12px var(--mono)}th{font:10px var(--mono);letter-spacing:1px;color:var(--muted);padding:13px 16px;border-bottom:1px solid var(--line-strong);text-transform:uppercase}td{padding:16px;border-bottom:1px solid var(--line);vertical-align:top}td:first-child{color:var(--muted)}td button{border:0;background:none;padding:0;color:var(--primary);text-align:left;font:12px var(--mono);text-decoration:underline;text-underline-offset:4px;max-width:400px;overflow-wrap:anywhere}.table-score{display:block;margin-bottom:5px;white-space:nowrap;font-size:10px}.selected{background:var(--hl-soft)}.batch-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.batch{border:1px solid var(--line);padding:20px;background:var(--surface)}.batch h3{font:15px var(--mono);margin:0 0 10px}.batch-actions{display:flex;align-items:center;gap:16px;margin-top:16px;font:11px var(--mono)}.batch-actions button{font-size:11px}.provenance{border-top:1px solid var(--line);padding:20px 0;font:12px var(--mono)}.provenance summary{cursor:pointer;color:var(--primary)}.provenance pre{font:11px var(--mono);color:var(--muted);max-height:340px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere}#archive-results{border:1px solid var(--line);padding:24px;margin-top:20px}#archive-list{display:grid;gap:8px}#archive-list button{text-align:left;font:12px var(--mono)}#archive-more{margin-top:16px}footer{display:flex;align-items:center;gap:30px;justify-content:space-between;padding:32px 44px 40px;border-top:1px solid var(--line);font-size:11px;color:var(--muted)}.brand-footer{color:var(--lime);font-size:22px;font-weight:700;letter-spacing:-.7px}.brand-footer span{font:9px var(--mono);letter-spacing:1px;margin-left:8px}footer p{line-height:1.7}
  @media(min-width:1500px){.pdf-slot{height:710px}}@media(max-width:1000px){.masthead,main,footer{padding-left:24px;padding-right:24px}.masthead nav{gap:16px}.intro{gap:30px}.telemetry{grid-template-columns:2fr 1fr}.telemetry>div{border-bottom:1px solid var(--line)}.telemetry>div:nth-child(2){border-right:0}.telemetry>div:nth-child(n+3){border-bottom:0}.cohorts{grid-template-columns:repeat(2,1fr)}.pdf-slot{height:480px}.evidence-toolbar>span{display:none}.batch-grid{grid-template-columns:repeat(2,1fr)}footer{flex-wrap:wrap}.intro h1{font-size:68px}}@media(max-width:650px){.masthead{gap:16px;padding-top:22px;padding-bottom:22px;flex-wrap:wrap}.brand{font-size:28px}.masthead nav{order:3;width:100%;margin:4px 0 0;font-size:12px;justify-content:space-between}.connection{margin-left:auto;font-size:10px}.intro{grid-template-columns:1fr;padding-top:38px;gap:12px}.intro h1{font-size:66px;letter-spacing:-3px}.intro-note{justify-self:start;max-width:none}.intro-note .spec{display:none}.telemetry>div{padding:16px}.telemetry strong{font-size:26px}.telemetry>div:first-child strong{font-size:13px}.cohorts{grid-template-columns:1fr 1fr;gap:8px}.cohort{padding:14px}.cohort-title{flex-direction:column;align-items:start;gap:6px}.cohort strong{font-size:29px}.cohort .mono{font-size:10px}.section-heading{align-items:start;flex-wrap:wrap}.evidence-toolbar{flex-wrap:wrap;gap:10px}.evidence-toolbar label{width:100%;justify-content:space-between}.fixture-info{flex-direction:column}.result-value{text-align:left}.pdf-grid,.detail-grid{grid-template-columns:1fr}.pdf-slot{height:500px}.detail-grid{gap:15px}.batch-grid{grid-template-columns:1fr}.rotate-controls button{font-size:11px;padding:9px 11px}footer{gap:8px}.label{font-size:9px}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
  .search-form{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}.search-form label{width:100%;font:11px var(--mono);color:var(--muted)}.search-form input{flex:1;min-width:200px;font:13px var(--mono);padding:12px;border:1px solid var(--line-strong);border-radius:var(--radius);background:var(--surface);color:inherit}.search-form input:focus-visible{outline:3px solid var(--lime);outline-offset:3px}.review-id{font-size:10px;max-width:110px;overflow-wrap:anywhere}.artifact-link{display:block;font:11px var(--mono);margin:14px 0}#history-more{margin-top:20px}
</style>

<style is:global>
.pdf-slot{display:flex;flex-direction:column;justify-content:flex-start;align-items:stretch;overflow:hidden}.pdf-controls{display:flex;justify-content:space-between;align-items:center;padding:8px;gap:8px;font:10px var(--mono);border-bottom:1px solid var(--line);flex:none}.pdf-controls button{padding:4px 9px}.pdf-paper{overflow:auto;flex:1;padding:12px;text-align:center}.pdf-paper canvas{display:block;background:white;margin:0 auto;max-width:100%;box-shadow:0 2px 12px var(--shadow)}
</style>
