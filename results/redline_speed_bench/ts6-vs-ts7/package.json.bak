{
  "name": "jubarte",
  "version": "0.1.0",
  "description": "Lossless document conversion engine: DOCX, HTML, PDF, Markdown, and JSON round-trip through a single typed AST, with tracked changes, comments, headers/footers, redlines, validation, repair, and password handling \u2014 in Node and the browser. TypeScript, ESM.",
  "keywords": [
    "ast",
    "browser",
    "browser-docx",
    "comments",
    "contract-automation",
    "document-conversion",
    "docx",
    "docx-browser",
    "docx-comments",
    "docx-converter",
    "docx-roundtrip",
    "docx-to-html",
    "esm",
    "html",
    "html-to-docx",
    "legal-tech",
    "mammoth",
    "microsoft-word",
    "ms-word",
    "ooxml",
    "ooxml-roundtrip",
    "redline",
    "redlines",
    "redlining",
    "roundtrip",
    "track-changes",
    "tracked-changes",
    "typescript",
    "word-document",
    "wordprocessingml"
  ],
  "homepage": "https://github.com/arthrod/jubarte-first",
  "bugs": {
    "url": "https://github.com/arthrod/jubarte-first/issues"
  },
  "license": "GPL-3.0-only",
  "author": {
    "name": "Arthur Souza Rodrigues",
    "email": "arthur@jandira.tech"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthrod/jubarte-first.git"
  },
  "bin": {
    "jubarte": "./bin/jubarte.js"
  },
  "files": [
    "dist",
    "bin",
    "licenses",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/node.cjs",
  "module": "./dist/browser.js",
  "types": "./dist/node.d.mts",
  "imports": {
    "#image-processor": {
      "node": "./src/docx-writer/src/utils/image-processor.node.ts",
      "default": "./src/docx-writer/src/utils/image-processor.browser.ts"
    },
    "#files": {
      "browser": "./src/docx-reader/lib/docx/files.browser.ts",
      "node": "./src/docx-reader/lib/docx/files.ts",
      "default": "./src/docx-reader/lib/docx/files.browser.ts"
    },
    "#pdf-lib": {
      "types": "./src/pdf/pdf-lib-shim.d.ts",
      "node": "./src/pdf/pdf-lib.node.ts",
      "default": "./src/pdf/pdf-lib.browser.ts"
    },
    "#pdfjs": {
      "types": "./src/pdf/pdfjs-shim.d.ts",
      "node": "./src/pdf/pdfjs.node.ts",
      "default": "./src/pdf/pdfjs.browser.ts"
    }
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/node.d.mts",
          "default": "./dist/node.mjs"
        },
        "require": {
          "types": "./dist/node.d.cts",
          "default": "./dist/node.cjs"
        }
      },
      "default": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      }
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./reader": {
      "browser": {
        "types": "./dist/reader.browser.d.ts",
        "import": "./dist/reader.browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/reader.node.d.mts",
          "default": "./dist/reader.node.mjs"
        },
        "require": {
          "types": "./dist/reader.node.d.cts",
          "default": "./dist/reader.node.cjs"
        }
      },
      "default": {
        "types": "./dist/reader.browser.d.ts",
        "import": "./dist/reader.browser.js"
      }
    },
    "./writer": {
      "browser": {
        "types": "./dist/writer.browser.d.ts",
        "import": "./dist/writer.browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/writer.node.d.mts",
          "default": "./dist/writer.node.mjs"
        },
        "require": {
          "types": "./dist/writer.node.d.cts",
          "default": "./dist/writer.node.cjs"
        }
      },
      "default": {
        "types": "./dist/writer.browser.d.ts",
        "import": "./dist/writer.browser.js"
      }
    },
    "./html": {
      "browser": {
        "types": "./dist/html.browser.d.ts",
        "import": "./dist/html.browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/html.node.d.mts",
          "default": "./dist/html.node.mjs"
        },
        "require": {
          "types": "./dist/html.node.d.cts",
          "default": "./dist/html.node.cjs"
        }
      },
      "default": {
        "types": "./dist/html.browser.d.ts",
        "import": "./dist/html.browser.js"
      }
    },
    "./pdf": {
      "browser": {
        "types": "./dist/pdf.browser.d.ts",
        "import": "./dist/pdf.browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/pdf.node.d.mts",
          "default": "./dist/pdf.node.mjs"
        },
        "require": {
          "types": "./dist/pdf.node.d.cts",
          "default": "./dist/pdf.node.cjs"
        }
      },
      "default": {
        "types": "./dist/pdf.browser.d.ts",
        "import": "./dist/pdf.browser.js"
      }
    },
    "./json": {
      "browser": {
        "types": "./dist/json.browser.d.ts",
        "import": "./dist/json.browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/json.node.d.mts",
          "default": "./dist/json.node.mjs"
        },
        "require": {
          "types": "./dist/json.node.d.cts",
          "default": "./dist/json.node.cjs"
        }
      },
      "default": {
        "types": "./dist/json.browser.d.ts",
        "import": "./dist/json.browser.js"
      }
    },
    "./compare": {
      "browser": {
        "types": "./dist/compare.browser.d.ts",
        "import": "./dist/compare.browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/compare.node.d.mts",
          "default": "./dist/compare.node.mjs"
        },
        "require": {
          "types": "./dist/compare.node.d.cts",
          "default": "./dist/compare.node.cjs"
        }
      },
      "default": {
        "types": "./dist/compare.browser.d.ts",
        "import": "./dist/compare.browser.js"
      }
    },
    "./structure": {
      "browser": {
        "types": "./dist/structure.browser.d.ts",
        "import": "./dist/structure.browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/structure.node.d.mts",
          "default": "./dist/structure.node.mjs"
        },
        "require": {
          "types": "./dist/structure.node.d.cts",
          "default": "./dist/structure.node.cjs"
        }
      },
      "default": {
        "types": "./dist/structure.browser.d.ts",
        "import": "./dist/structure.browser.js"
      }
    },
    "./semantic": {
      "browser": {
        "types": "./dist/semantic.browser.d.ts",
        "import": "./dist/semantic.browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/semantic.node.d.mts",
          "default": "./dist/semantic.node.mjs"
        },
        "require": {
          "types": "./dist/semantic.node.d.cts",
          "default": "./dist/semantic.node.cjs"
        }
      },
      "default": {
        "types": "./dist/semantic.browser.d.ts",
        "import": "./dist/semantic.browser.js"
      }
    },
    "./lossless": {
      "browser": {
        "types": "./dist/lossless.browser.d.ts",
        "import": "./dist/lossless.browser.js"
      },
      "node": {
        "import": {
          "types": "./dist/lossless.node.d.mts",
          "default": "./dist/lossless.node.mjs"
        },
        "require": {
          "types": "./dist/lossless.node.d.cts",
          "default": "./dist/lossless.node.cjs"
        }
      },
      "default": {
        "types": "./dist/lossless.browser.d.ts",
        "import": "./dist/lossless.browser.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --dts --config-loader tsx",
    "clean": "rm -rf dist",
    "lint": "oxlint src",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage",
    "test:roundtrip-artifacts": "bun run scripts/validate-roundtrip-artifacts.mjs",
    "fidelity:check": "node --import tsx scripts/fidelity-ratchet.ts check",
    "fidelity:update": "node --import tsx scripts/fidelity-ratchet.ts update",
    "test:documentbuilder-wordvalid": "node --import tsx scripts/validate-documentbuilder-output.ts",
    "fixtures:critic": "node --import tsx scripts/generate-critic-fixtures.ts",
    "corpus-pipeline": "node --import tsx scripts/corpus-pipeline.ts",
    "report:superdoc-corpus": "node --import tsx scripts/run-superdoc-corpus.ts",
    "typecheck": "tsc --noEmit",
    "publint": "publint",
    "attw": "attw --pack .",
    "validate": "bun run build && bun run check:core-public-surface && bun run test",
    "check:lossless-loc": "node scripts/check-lossless-port-loc.mjs",
    "check:core-public-surface": "node --experimental-strip-types scripts/check-core-public-surface.ts",
    "prepublishOnly": "bun run build && bun run publint && bun run attw",
    "update:public-surface": "bun scripts/check-core-public-surface.ts --update",
    "profile:runtime": "node scripts/profile-bundle-runtime.mjs",
    "profile:ts6-vs-ts7": "node scripts/compare-ts6-ts7-runtime.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.7.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdfme/common": "^6.1.11",
    "@pdfme/converter": "^6.1.11",
    "@pdfme/generator": "^6.1.11",
    "@pdfme/schemas": "^6.1.11",
    "@xmldom/xmldom": "^0.9.10",
    "base64-js": "^1.5.1",
    "color-name": "^2.1.0",
    "commander": "^15.0.0",
    "crypto-js": "^4.2.0",
    "csv-parse": "^7.0.1",
    "dingbat-to-unicode": "^1.0.1",
    "es-toolkit": "^1.49.0",
    "fast-xml-parser": "^5.9.3",
    "fflate": "^0.8.3",
    "html-entities": "^2.6.0",
    "jszip": "^3.10.1",
    "lop": "^0.4.2",
    "pdfjs-dist": "6.1.200",
    "prosemirror-model": "^1.25.10",
    "tmp": "^0.2.7",
    "underscore": "^1.13.8",
    "unpdf": "^1.6.2",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@changedown/core": "^0.5.0",
    "@codspeed/vitest-plugin": "5.7.1",
    "@types/node": "^26.1.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "argparse": "^3.0.0",
    "diff": "^9.0.0",
    "docx-validate": "^0.5.0",
    "duck": "^0.1.12",
    "esbuild": "^0.28.1",
    "html-validate": "^11.5.5",
    "lefthook": "^2.1.9",
    "linkedom": "^0.18.12",
    "playwright": "^1.61.1",
    "publint": "^0.3.21",
    "sonda": "^0.14.0",
    "tsdown": "^0.22.8",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0",
    "vite-plus": "^0.2.2",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "libxmljs2": "^0.37.0",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.14"
}
