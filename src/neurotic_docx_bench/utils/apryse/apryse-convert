#!/usr/bin/env bash
# Entry point the bench resolves for --tool apryse (#100): apryse-convert SRC DEST, or
# --version. Runs neurotic_docx_bench.apryse_gen with the repo's .venv (apryse-sdk is a
# project dependency) and this checkout's src first on the path, so a worktree runs its
# own code rather than the shared venv's editable install.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../../../.." && pwd)"
export PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}"
if [ "$1" = "--version" ]; then
  exec "$root/.venv/bin/python" -m neurotic_docx_bench.apryse_gen version
fi
exec "$root/.venv/bin/python" -m neurotic_docx_bench.apryse_gen convert "$@"
